<Window x:Class="PoeMarketWatch.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session cookies" Height="560" Width="580" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#12100E" Foreground="#D8CBB4">
    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#3A322A"/>
        <SolidColorBrush x:Key="Dim" Color="#8A7E6C"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0E0C0A"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#C8A96A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A241E"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A322A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4A3A22"/>
            <Setter Property="BorderBrush" Value="#C8A96A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <!-- Rows: content scrolls, footer is pinned. The footer must never be reachable
         only by resizing the window; that was the original bug. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="20,20,20,10">
            <StackPanel>
                <TextBlock Text="Path of Exile session" FontSize="16" FontWeight="SemiBold"
                           Foreground="#C8A96A" Margin="0,0,0,10"/>

                <Border Background="#1C1917" BorderBrush="#5A3A2A" BorderThickness="1"
                        Padding="12" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="These are full-account credentials." FontWeight="SemiBold"
                                   Foreground="#C4574B" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#B0A390">
                            There is no OAuth scope for the trade API, so live search and travel need
                            your raw session cookies. Anyone holding them can act as you on the website.
                            They are encrypted with Windows DPAPI for your user account only, kept out
                            of the program folder, and never written to logs. Log out of pathofexile.com
                            to revoke them.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="Recommended: paste the whole Cookie header" FontWeight="SemiBold"
                           Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}"
                           Margin="0,0,0,6">
                    F12 - Network - click any request to pathofexile.com - Headers - Request Headers -
                    right-click the "cookie" line and copy its value. Paste it all here. This keeps
                    every cookie the browser sends (POESESSID, POETOKEN, cf_clearance and anything
                    else), which avoids guessing which one the API actually wants.
                </TextBlock>
                <PasswordBox x:Name="HeaderBox" Height="30" Margin="0,0,0,14"/>

                <TextBlock Text="Or enter them individually" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <TextBlock Text="POESESSID" Margin="0,0,0,4"/>
                <PasswordBox x:Name="SessBox" Height="30" Margin="0,0,0,12"/>

                <TextBlock Text="POETOKEN" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TokenBox" Height="30" Margin="0,0,0,14"/>

                <TextBlock Text="User-Agent" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}"
                           Margin="0,0,0,6">
                    Only change this if you pasted a cf_clearance cookie. Cloudflare binds that
                    cookie to the exact User-Agent that obtained it, so it must match your browser
                    or the request is rejected.
                </TextBlock>
                <TextBox x:Name="UaBox" Height="30" Margin="0,0,0,10"
                         Background="#0E0C0A" Foreground="#D8CBB4" BorderBrush="{StaticResource Line}"
                         Padding="6,4" CaretBrush="#C8A96A" FontFamily="Consolas" FontSize="11"/>

                <TextBlock x:Name="ErrorText" Foreground="#C4574B" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#1C1917" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Forget stored" Click="OnClear"
                        ToolTip="Delete the stored session from this machine"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Cancel" Click="OnCancel" IsCancel="True" Margin="0,0,10,0"/>
                    <Button Content="Save" Click="OnSave" IsDefault="True" Style="{StaticResource Primary}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
