<Window x:Class="PoeMarketWatch.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session cookies" Height="430" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#12100E" Foreground="#D8CBB4">
    <Window.Resources>
        <SolidColorBrush x:Key="Line" Color="#3A322A"/>
        <SolidColorBrush x:Key="Dim" Color="#8A7E6C"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E0C0A"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#C8A96A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0E0C0A"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#C8A96A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A241E"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Path of Exile session" FontSize="16" FontWeight="SemiBold"
                   Foreground="#C8A96A" Margin="0,0,0,10"/>

        <Border Background="#1C1917" BorderBrush="#5A3A2A" BorderThickness="1" Padding="12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="These are full-account credentials." FontWeight="SemiBold"
                           Foreground="#C4574B" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#B0A390">
                    There is no OAuth scope for the trade API, so live search and travel need your
                    raw session cookies. Anyone holding them can act as you on the website. They are
                    encrypted with Windows DPAPI for your user account only, kept out of the program
                    folder, and never written to logs. Log out of pathofexile.com to revoke them.
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="Where to find them" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,14">
            Log in at pathofexile.com, press F12, open Application (or Storage) → Cookies →
            https://www.pathofexile.com, and copy the values of POESESSID and POETOKEN.
        </TextBlock>

        <TextBlock Text="POESESSID (required)" Margin="0,0,0,4"/>
        <PasswordBox x:Name="SessBox" Height="28" Margin="0,0,0,10"/>

        <TextBlock Text="POETOKEN (recommended)" Margin="0,0,0,4"/>
        <PasswordBox x:Name="TokenBox" Height="28" Margin="0,0,0,16"/>

        <TextBlock x:Name="ErrorText" Foreground="#C4574B" FontSize="12" Margin="0,0,0,8"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Forget stored session" Click="OnClear" Margin="0,0,8,0"/>
            <Button Content="Cancel" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="Save" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
