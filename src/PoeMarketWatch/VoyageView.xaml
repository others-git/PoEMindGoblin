<UserControl x:Class="PoeMarketWatch.VoyageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#12100E" Foreground="#D8CBB4"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1C1917"/>
        <SolidColorBrush x:Key="Line" Color="#3A322A"/>
        <SolidColorBrush x:Key="Gold" Color="#C8A96A"/>
        <SolidColorBrush x:Key="Dim" Color="#8A7E6C"/>
        <SolidColorBrush x:Key="Good" Color="#7FA65B"/>
        <SolidColorBrush x:Key="Bad" Color="#C4574B"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A241E"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A322A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A241E"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- controls -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReadPanelBtn" Content="Read panel" Click="OnReadPanel"
                            ToolTip="Screenshot the game and decode every chart's shape and level"/>
                    <ToggleButton x:Name="ReadModeBtn" Content="Read mode" Margin="8,0,0,0"
                                  Padding="10,5" Background="#2A241E" Foreground="#D8CBB4"
                                  BorderBrush="{StaticResource Line}" Cursor="Hand"
                                  Checked="OnReadModeChanged" Unchecked="OnReadModeChanged"
                                  ToolTip="Hover a chart in game and press Ctrl+C; each copy ticks one off"/>
                    <TextBlock Text="Profile" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" Margin="16,0,6,0"/>
                    <ComboBox x:Name="ProfileBox" Width="150" VerticalAlignment="Center"
                              SelectionChanged="OnProfileChanged"/>
                    <Button Content="Edit rules…" Click="OnEditRules" Margin="8,0,0,0"
                            ToolTip="Opens the rule file. Saved edits apply immediately."/>
                    <Button x:Name="SolveBtn" Content="Solve" Click="OnSolve" Margin="16,0,0,0"
                            FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Calibrate…" Click="OnCalibrate" Margin="0,0,8,0"
                            ToolTip="Panel coordinates. Edit if the read misses charts at your resolution."/>
                    <Button Content="Reset" Click="OnReset" Margin="0,0,8,0"/>
                    <Button x:Name="PopOutBtn" Content="Pop out" Click="OnPopOut"
                            ToolTip="Move to its own window for a second monitor"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- board + plan -->
            <DockPanel Grid.Column="0" Margin="14">
                <TextBlock DockPanel.Dock="Top" Text="BOARD" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        HorizontalAlignment="Left">
                    <UniformGrid x:Name="BoardGrid" Rows="3" Columns="3" Width="330" Height="330"/>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="PLAN" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Dim}" Margin="0,16,0,6"/>
                <TextBlock DockPanel.Dock="Bottom" x:Name="SolveInfo" FontSize="11"
                           Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <ListBox x:Name="PlanList" Background="Transparent" BorderThickness="0"
                         Foreground="#D8CBB4" FontFamily="Consolas" FontSize="13"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>

            <!-- figurines -->
            <DockPanel Grid.Column="1" Margin="0,14,14,14" Width="230">
                <TextBlock DockPanel.Dock="Top" x:Name="FigurineHeader" Text="FIGURINES"
                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}"
                           Margin="0,0,0,8"/>
                <ListBox x:Name="FigurineList" Background="Transparent" BorderThickness="0"
                         SelectionChanged="OnFigurineSelected"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,5" BorderBrush="#3A322A" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Tick}" Width="16"
                                                   Foreground="{Binding TickBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" FontSize="11" Foreground="#8A7E6C"
                                               TextWrapping="Wrap" Margin="16,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- chart panel mirror -->
            <DockPanel Grid.Column="2" Margin="0,14,14,14">
                <TextBlock DockPanel.Dock="Top" x:Name="PanelHeader" Text="CHARTS" FontSize="11"
                           FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="0,0,0,8"/>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <UniformGrid x:Name="PanelGrid" Rows="10" Columns="6"/>
                </Border>
            </DockPanel>
        </Grid>

        <!-- status -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Text="Open the Voyage screen in game, then Read panel."
                           Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" x:Name="Progress" Foreground="{StaticResource Gold}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
