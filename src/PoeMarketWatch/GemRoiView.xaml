<UserControl x:Class="PoeMarketWatch.GemRoiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#12100E" Foreground="#D8CBB4">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Panel" Color="#1C1917"/>
        <SolidColorBrush x:Key="Line" Color="#3A322A"/>
        <SolidColorBrush x:Key="Gold" Color="#C8A96A"/>
        <SolidColorBrush x:Key="Dim" Color="#8A7E6C"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E0C0A"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="CaretBrush" Value="#C8A96A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2A241E"/>
            <Setter Property="Foreground" Value="#D8CBB4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- controls -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="League" Margin="0,0,6,0" Foreground="{StaticResource Dim}"/>
                    <TextBox x:Name="LeagueBox" Width="120" Height="26" Margin="0,0,16,0"/>

                    <CheckBox x:Name="IgnoreQuality" Content="Ignore quality" Margin="0,0,14,0"
                              ToolTip="Do not spend Gemcutter's Prisms - sell at 20/0"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>
                    <CheckBox x:Name="IgnoreCorruption" Content="Ignore corruption" Margin="0,0,16,0"
                              ToolTip="Do not vaal - stop at 20/20"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged"/>

                    <TextBlock Text="Min listings/day" Margin="0,0,6,0" Foreground="{StaticResource Dim}"/>
                    <TextBox x:Name="MinVolumeBox" Width="46" Height="26" Text="5" Margin="0,0,16,0"
                             ToolTip="Ignore prices backed by too few listings to actually trade against"/>

                    <Button x:Name="RefreshBtn" Content="Refresh prices" Click="OnRefresh" Margin="0,0,8,0"/>
                    <Button Content="Corruption odds..." Click="OnOdds"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Gemcutter's Prism" Foreground="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBox x:Name="GcpBox" Width="60" Height="24" Margin="0,0,4,0"/>
                    <TextBlock Text="c" Foreground="{StaticResource Dim}" Margin="0,0,16,0"/>
                    <TextBlock Text="Vaal Orb" Foreground="{StaticResource Dim}" Margin="0,0,6,0"/>
                    <TextBox x:Name="VaalBox" Width="60" Height="24" Margin="0,0,4,0"/>
                    <TextBlock Text="c" Foreground="{StaticResource Dim}" Margin="0,0,16,0"/>
                    <Button Content="Recalculate" Click="OnRecalculate"/>
                    <TextBlock x:Name="PriceNote" Foreground="{StaticResource Dim}" FontSize="11"
                               Margin="16,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- status -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource Dim}"
                       Text="Press Refresh prices to pull the current market."/>
        </Border>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#12100E" RowBackground="#12100E" AlternatingRowBackground="#171412"
                  Foreground="#D8CBB4" BorderThickness="0" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#26211C" HeadersVisibility="Column"
                  CanUserSortColumns="True" SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1C1917"/>
                    <Setter Property="Foreground" Value="#C8A96A"/>
                    <Setter Property="BorderBrush" Value="#3A322A"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#2A241E"/>
                            <Setter Property="Foreground" Value="#D8CBB4"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Gem" Binding="{Binding Gem}" Width="2*"/>
                <DataGridTextColumn Header="Path" Binding="{Binding PathName}" Width="*"/>
                <DataGridTextColumn Header="Buy" Binding="{Binding BuyText}" Width="0.7*"/>
                <DataGridTextColumn Header="Currency" Binding="{Binding CurrencyText}" Width="0.7*"/>
                <DataGridTextColumn Header="Sell (exp.)" Binding="{Binding RevenueText}" Width="0.8*"/>
                <DataGridTextColumn Header="Profit" Binding="{Binding ProfitText}" Width="0.8*"/>
                <DataGridTextColumn Header="RoI" Binding="{Binding RoiText}" Width="0.7*"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
