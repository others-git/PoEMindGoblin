<UserControl x:Class="MindGoblin.VoyageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MindGoblin"
             Background="#080706" Foreground="#E6DBC2"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <!--
        Palette and type come from the Voyage screen's own materials: bitumen ink on aged
        chart paper, tarnished bronze figureheads, verdigris on sea-metal. Brass is spent
        almost entirely on the plan numbers, because "which chart goes in which square" is
        the one thing this panel exists to answer and it should be the first thing seen.

        Fontin carries the headings and numerals when the user has dropped the TTFs into
        MindGoblin_data/fonts (see PoeFonts; the license forbids shipping them);
        Georgia is the nearest installed face otherwise, and an
        engraved serif beside the drawn ornaments reads as part of the same object.
        Consolas carries the plan and the levels, which have to align in a column.
    -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Abyss"     Color="#080706"/>
        <SolidColorBrush x:Key="Slate"     Color="#131110"/>
        <SolidColorBrush x:Key="Raised"    Color="#1B1714"/>
        <SolidColorBrush x:Key="Silt"      Color="#2A2018"/>
        <SolidColorBrush x:Key="Brass"     Color="#C8AA6E"/>
        <SolidColorBrush x:Key="BrassDim"  Color="#A38D6D"/>
        <SolidColorBrush x:Key="Verdigris" Color="#86A86A"/>
        <SolidColorBrush x:Key="Rust"      Color="#B8503E"/>
        <SolidColorBrush x:Key="Bone"      Color="#E6DBC2"/>
        <SolidColorBrush x:Key="Ash"       Color="#94866F"/>
        <SolidColorBrush x:Key="Shade"     Color="#6B5F4E"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6DBC2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="Eyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{x:Static local:PoeFonts.Display}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8A7A5E"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Sea-metal frame edge: verdigris darkening toward the middle, the way the
             game's Voyage chrome is cast. Drawn, not an image: there is no licensed
             art to borrow, and gradients scale with the window where a bitmap cannot. -->
        <LinearGradientBrush x:Key="FrameEdge" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4A6B52" Offset="0"/>
            <GradientStop Color="#22342A" Offset="0.5"/>
            <GradientStop Color="#3A5644" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BracketStroke" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#C8AA6E" Offset="0"/>
            <GradientStop Color="#6E8A5E" Offset="1"/>
        </LinearGradientBrush>
        <!-- Slightly translucent so the abyss glows through the panel corners. -->
        <SolidColorBrush x:Key="PanelFill" Color="#F00B0E0C"/>

        <!-- A carved panel: sea-metal edge, faint gold inner hairline, bracketed
             corners. Every floating panel wears this so the columns read as objects
             lying over the depths rather than regions of one flat page. -->
        <Style x:Key="Carved" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Border Background="{StaticResource PanelFill}"
                                    BorderBrush="{StaticResource FrameEdge}" BorderThickness="1">
                                <Border BorderBrush="#1EC8AA6E" BorderThickness="1" Margin="2"
                                        Padding="12">
                                    <ContentPresenter/>
                                </Border>
                            </Border>
                            <Path Data="M 0,14 L 0,0 L 14,0" Stroke="{StaticResource BracketStroke}"
                                  StrokeThickness="1.6" HorizontalAlignment="Left"
                                  VerticalAlignment="Top" Margin="1"/>
                            <Path Data="M 0,0 L 14,0 L 14,14" Stroke="{StaticResource BracketStroke}"
                                  StrokeThickness="1.6" HorizontalAlignment="Right"
                                  VerticalAlignment="Top" Margin="1"/>
                            <Path Data="M 0,0 L 0,14 L 14,14" Stroke="{StaticResource BracketStroke}"
                                  StrokeThickness="1.6" HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom" Margin="1"/>
                            <Path Data="M 14,0 L 14,14 L 0,14" Stroke="{StaticResource BracketStroke}"
                                  StrokeThickness="1.6" HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom" Margin="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E6DBC2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" BorderBrush="#453A2C"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2C241C" Offset="0"/>
                                    <GradientStop Color="#171310" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#332818"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#C8AA6E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1509"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="#C8AA6E" BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E0B62C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#E6DBC2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" BorderBrush="#453A2C"
                                BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2C241C" Offset="0"/>
                                    <GradientStop Color="#171310" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#3A2E14"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#C8AA6E"/>
                                <Setter Property="Foreground" Value="#C8AA6E"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#302518"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The default WPF slider is a white pill on a chrome track: unreadable
             here. This one is the page's own language: a sunken rail, the filled
             half in dim gold, a brass thumb. -->
        <Style x:Key="Tuner" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="18" Background="Transparent">
                            <Border Height="3" VerticalAlignment="Center"
                                    Background="#2A231C" CornerRadius="1.5"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="18">
                                                    <Border Height="3" VerticalAlignment="Center"
                                                            Background="#8A7350" CornerRadius="1.5"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="18"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="11" Height="15" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="2" BorderThickness="1"
                                                        BorderBrush="#6E5A34">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#E7D7AB" Offset="0"/>
                                                            <GradientStop Color="#C8AA6E" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C0A09"/>
            <Setter Property="Foreground" Value="#E6DBC2"/>
            <Setter Property="BorderBrush" Value="#2A2018"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#C8AA6E"/>
            <Setter Property="SelectionBrush" Value="#A38D6D"/>
        </Style>

        <!-- The stock dropdown paints itself with system colours: a near-white popup
             behind light text, unreadable on this ground. Restyling ComboBoxItem alone
             leaves the popup chrome light, so the whole control is templated. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6DBC2"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#302518"/>
                                <Setter Property="Foreground" Value="#C8AA6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6DBC2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tb" Background="#221B15"
                                                BorderBrush="#2A2018" BorderThickness="1">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Fill="#6B5F4E"
                                                  Data="M 0 0 L 7 0 L 3.5 4.5 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tb" Property="BorderBrush" Value="#A38D6D"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,6,26,6" VerticalAlignment="Center"
                                              IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="#1B1714" BorderBrush="#2A2018" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltips carry captured modifier text, so they are content, not chrome. -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#E6DBC2"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
            <Setter Property="ToolTipService.ShowDuration" Value="120000"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="400"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="#0C0A09" BorderBrush="#2A2018"
                                BorderThickness="1" Padding="11,9">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Plain" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== the abyss =====
             Layered light under every panel: a teal glow from above (the surface), a
             fainter green seep from below, and a vignette pressing in at the edges.
             Painted with gradients rather than a bitmap: it scales with the window
             and there is no licensed sea art to borrow. -->
        <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle Fill="#060907"/>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.0" GradientOrigin="0.5,0.0"
                                         RadiusX="0.95" RadiusY="0.8">
                        <GradientStop Color="#5E2E5F51" Offset="0"/>
                        <GradientStop Color="#00060907" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.12,1.0" GradientOrigin="0.12,1.0"
                                         RadiusX="0.7" RadiusY="0.55">
                        <GradientStop Color="#4A234A3C" Offset="0"/>
                        <GradientStop Color="#00060907" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle>
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45"
                                         RadiusX="1.05" RadiusY="0.95">
                        <GradientStop Color="#00000000" Offset="0.55"/>
                        <GradientStop Color="#96000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ===== toolbar ===== -->
        <Border Grid.Row="0" Background="#E60E100E" BorderThickness="0,0,0,1" Padding="16,11">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00C8AA6E" Offset="0"/>
                    <GradientStop Color="#66C8AA6E" Offset="0.35"/>
                    <GradientStop Color="#66C8AA6E" Offset="0.65"/>
                    <GradientStop Color="#00C8AA6E" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Identify Charts" Click="OnReadPanel"
                            ToolTip="Screenshot the game and decode every chart's shape and level"/>
                    <ToggleButton x:Name="SlurpBtn" Content="Slurp" Margin="8,0,0,0"
                                  Checked="OnSlurpChanged" Unchecked="OnSlurpChanged"
                                  ToolTip="Step-through import: arm this, then in PoE press F9 once per chart. Each press hovers one cell and copies it — one action per keypress."/>
                    <ToggleButton x:Name="ReadModeBtn" Content="Load Details" Margin="8,0,0,0"
                                  Checked="OnReadModeChanged" Unchecked="OnReadModeChanged"
                                  ToolTip="Guided pass: the app names each chart and square, you copy it in game"/>
                    <TextBlock x:Name="CaptureHint" Foreground="#86A86A" FontSize="12"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Rectangle Width="1" Height="22" Fill="{StaticResource Silt}" Margin="18,0"/>
                    <TextBlock Text="Optimise for" Foreground="{StaticResource Shade}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- An explicit ItemTemplate, not DisplayMemberPath: a templated
                         ComboBox renders SelectionBoxItem through SelectionBoxItemTemplate,
                         and with only a path set that comes out as the type name. -->
                    <ComboBox x:Name="ProfileBox" Width="150" VerticalAlignment="Center"
                              SelectionChanged="OnProfileChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#E6DBC2"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Edit rules" Click="OnEditRules" Margin="8,0,0,0"
                            ToolTip="Opens the rule file. Saved edits apply immediately."/>
                    <Button Content="Restore rules" Click="OnRestoreRules" Margin="6,0,0,0"
                            ToolTip="Replace every profile with the shipped ones, discarding your edits."/>
                    <Button x:Name="WeightsBtn" Content="Weights" Click="OnToggleWeights" Margin="6,0,0,0"
                            ToolTip="Category emphasis sliders for the selected profile. 10 is the shipped baseline."/>
                    <Button x:Name="SolveBtn" Content="Solve" Click="OnSolve" Margin="18,0,0,0"
                            Style="{StaticResource Primary}"/>
                    <!-- The pre-dive ritual, floated over the toolbar after every solve:
                         boxes get juiced BEFORE they are opened, and the orbs cannot be
                         fetched once you are on the seafloor. Non-modal: it steals no
                         focus, dies on its own, and a click dismisses it early. -->
                    <Popup x:Name="AlchNote" AllowsTransparency="True" Placement="Top"
                           PlacementTarget="{Binding ElementName=SolveBtn}"
                           PopupAnimation="Fade" VerticalOffset="-10" Focusable="False">
                        <Border Background="#F5161108" BorderBrush="#C8AA6E" BorderThickness="1"
                                Padding="14,8" Margin="8" Cursor="Hand"
                                MouseDown="OnAlchNoteClick">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="14"
                                                  ShadowDepth="3" Opacity="0.7"/>
                            </Border.Effect>
                            <TextBlock Text="DON'T FORGET YOUR ALCHS"
                                       FontFamily="{x:Static local:PoeFonts.Display}"
                                       FontSize="14" Foreground="#E7D7AB"/>
                        </Border>
                    </Popup>
                    <Button x:Name="DiveBtn" Content="Dive again" Click="OnNextVoyage" Margin="8,0,0,0"
                            ToolTip="Voyage complete: spend the placed charts, clear the board, and re-read the rerolled border"/>
                    <!-- The post-dive twin of the alch note: the border rerolled, and a
                         plan on stale board modifiers is confidently wrong. -->
                    <Popup x:Name="BoardNote" AllowsTransparency="True" Placement="Top"
                           PlacementTarget="{Binding ElementName=DiveBtn}"
                           PopupAnimation="Fade" VerticalOffset="-10" Focusable="False">
                        <Border Background="#F5161108" BorderBrush="#C8AA6E" BorderThickness="1"
                                Padding="14,8" Margin="8" Cursor="Hand"
                                MouseDown="OnBoardNoteClick">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="14"
                                                  ShadowDepth="3" Opacity="0.7"/>
                            </Border.Effect>
                            <TextBlock Text="READ NEW BOARD MODIFIERS"
                                       FontFamily="{x:Static local:PoeFonts.Display}"
                                       FontSize="14" Foreground="#E7D7AB"/>
                        </Border>
                    </Popup>
                    <Button Content="Stash search" Click="OnCopyStashSearch" Margin="8,0,0,0"
                            ToolTip="Copy an in-game search string that highlights the solved board's charts in your chart stash"/>
                    <!-- The solve runs on a worker for up to 3 s; this is the sign that
                         the silence is work, not a hang. -->
                    <ProgressBar x:Name="SolveBusy" Width="88" Height="5" IsIndeterminate="True"
                                 Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0"
                                 Foreground="{StaticResource Brass}" Background="{StaticResource Slate}"
                                 BorderThickness="0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Calibrate" Click="OnCalibrate" Margin="0,0,8,0"
                            ToolTip="Panel coordinates. Edit if the read misses charts at your resolution."/>
                    <ToggleButton x:Name="RemoveBtn" Content="Remove" Margin="0,0,8,0"
                                  Checked="OnRemoveModeChanged" Unchecked="OnRemoveModeChanged"
                                  ToolTip="While armed, clicking a figurine or square erases its reading; clicking a chart strips its detail (again removes the chart). Nothing else is touched."/>
                    <Button Content="Clear" Click="OnReset"
                            ToolTip="Forget everything: charts, modifiers, the saved session"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== modifiers | board | charts ===== -->
        <Grid Grid.Row="1">
            <!-- The board is the answer, so it takes the slack; the modifier list is
                 reference material and gets a fixed, narrower column. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="420"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- modifiers: everything captured, and what it applies to -->
            <ContentControl Grid.Column="0" Style="{StaticResource Carved}" Margin="14,14,5,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="ModifierHeader" Text="M O D I F I E R S"
                           Style="{StaticResource Eyebrow}"/>
                <!-- The scope legend, in the game's colour language: it is what the
                     tooltip mod colours mean, said once where the mods live. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="2,10,0,0">
                    <Rectangle Width="8" Height="8" Fill="#8888FF" VerticalAlignment="Center"/>
                    <TextBlock Text="this area" FontSize="11" Foreground="{StaticResource Ash}"
                               Margin="5,0,12,0" VerticalAlignment="Center"/>
                    <Rectangle Width="8" Height="8" Fill="#D9C956" VerticalAlignment="Center"/>
                    <TextBlock Text="adjacent" FontSize="11" Foreground="{StaticResource Ash}"
                               Margin="5,0,12,0" VerticalAlignment="Center"/>
                    <Rectangle Width="8" Height="8" Fill="#AF6025" VerticalAlignment="Center"/>
                    <TextBlock Text="whole voyage" FontSize="11" Foreground="{StaticResource Ash}"
                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <ListBox x:Name="ModifierList" Style="{StaticResource Plain}"
                         SelectionChanged="OnModifierSelected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="11,9" Margin="0,0,0,4"
                                    Background="{Binding RowBackground}"
                                    BorderBrush="{Binding Accent}" BorderThickness="2,0,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontFamily="{x:Static local:PoeFonts.Display}"
                                                   FontSize="13" Foreground="{Binding Accent}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Where}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   Foreground="{StaticResource Shade}"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Text}" FontSize="12"
                                               Foreground="{Binding TextBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </ContentControl>

            <!-- board: the answer -->
            <ContentControl Grid.Column="1" Style="{StaticResource Carved}" Margin="5,14,5,14">
            <Grid>
                <DockPanel>
                    <!-- The eyebrow row carries the alert toggle, so having something to
                         warn about costs the board no height at all. -->
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="B O A R D" Style="{StaticResource Eyebrow}"/>
                        <Button x:Name="AlertToggle" Visibility="Collapsed" Click="OnToggleAlerts"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Padding="10,2" FontSize="12" Margin="0,-5,0,0"/>
                    </Grid>

                    <Grid x:Name="BoardHost" DockPanel.Dock="Top" HorizontalAlignment="Center"/>

                    <TextBlock DockPanel.Dock="Top" x:Name="SummaryHeader" Text="V O Y A G E"
                               Style="{StaticResource Eyebrow}" Margin="0,20,0,8"/>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="SolveInfo" FontSize="12"
                               Foreground="{StaticResource Shade}" TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                    <!-- Bounded, and left-aligned: the board column is wide, and a label at
                         one end with its number at the other is two columns, not a row. -->
                    <ListBox x:Name="SummaryList" Style="{StaticResource Plain}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- The number leads. A right-aligned value column reflows
                                     the moment a scrollbar appears, which walked the figures
                                     sideways as the list grew. -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding Value}" FontFamily="Consolas"
                                               FontSize="{Binding Size}"
                                               Foreground="{Binding ValueBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Label}" FontFamily="{Binding Font}"
                                               FontSize="{Binding Size}" Foreground="{Binding Brush}"
                                               TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Modifiers worth stopping for.
                     OVER the board rather than above it. This list is usually empty, and a
                     strip that reserves height for the times it is not would push the board
                     down permanently to serve the exceptional case. Laid on top it costs
                     nothing when there is nothing to say, and covers the board only while it
                     is being read. The accent bar carries the meaning: brass for a jackpot,
                     rust for something that reads like a reward and costs you. -->
                <!-- The slurp coach: which chart the next F9 will capture, and how far
                     along the pass is. Lives over the board so it is readable at a
                     glance from the game via alt-tab peek. -->
                <Border x:Name="SlurpPanel" Visibility="Collapsed" Panel.ZIndex="13"
                        VerticalAlignment="Top" Margin="0,24,0,0" Padding="14,10"
                        Width="380" HorizontalAlignment="Center"
                        Background="{StaticResource PanelFill}"
                        BorderBrush="{StaticResource FrameEdge}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5"
                                          Opacity="0.8"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}" Text="S L U R P"/>
                        <TextBlock x:Name="SlurpInfo" Foreground="{StaticResource Bone}"
                                   FontSize="13" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Skip this chart" Click="OnSlurpSkip"
                                    ToolTip="Move on without capturing it — it stays awaiting detail"/>
                            <Button Content="Stop" Click="OnSlurpStop" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Category emphasis sliders, laid over the board like the alerts:
                     tuning is occasional, and a strip that reserves height for it would
                     tax the board permanently. Rows are built in code, one per category
                     the active profile has rules in. -->
                <!-- After a voyage with a "Charts aren't consumed" chance in play:
                     which of the nine came back? Spending all would discard the refund. -->
                <Border x:Name="PreservePanel" Visibility="Collapsed" Panel.ZIndex="12"
                        VerticalAlignment="Top" Margin="0,24,0,0" Padding="14,10"
                        MaxWidth="440" HorizontalAlignment="Center"
                        Background="{StaticResource PanelFill}"
                        BorderBrush="{StaticResource FrameEdge}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5"
                                          Opacity="0.8"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Eyebrow}"
                                   Text="W H I C H   C H A R T S   S U R V I V E D ?"/>
                        <TextBlock Foreground="{StaticResource Shade}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,4,0,8"
                                   Text="A chart-refund chance was in play. Toggle the charts that came back; the rest are spent."/>
                        <WrapPanel x:Name="PreserveList"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Spend the rest" Click="OnPreserveConfirm"
                                    Style="{StaticResource Primary}"/>
                            <Button Content="Cancel" Click="OnPreserveCancel" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="WeightsPanel" Visibility="Collapsed" Panel.ZIndex="11"
                        VerticalAlignment="Top" Margin="0,24,0,0" Padding="14,10"
                        Width="430" HorizontalAlignment="Center"
                        Background="{StaticResource PanelFill}"
                        BorderBrush="{StaticResource FrameEdge}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5"
                                          Opacity="0.8"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="WeightsTitle" Style="{StaticResource Eyebrow}"
                                       Text="W E I G H T S"/>
                            <Button Content="Reset" Click="OnResetWeights" Padding="10,2"
                                    FontSize="12" HorizontalAlignment="Right" Margin="0,-4,0,0"
                                    ToolTip="Back to the shipped weights for this profile"/>
                        </Grid>
                        <StackPanel x:Name="WeightsList"/>
                    </StackPanel>
                </Border>

                <Border x:Name="AlertPanel" Visibility="Collapsed" Panel.ZIndex="10"
                        VerticalAlignment="Top" Margin="0,24,0,0" Padding="6"
                        Background="{StaticResource PanelFill}"
                        BorderBrush="{StaticResource FrameEdge}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5"
                                          Opacity="0.8"/>
                    </Border.Effect>
                    <ItemsControl x:Name="AlertList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBackground}"
                                        BorderBrush="{Binding Accent}" BorderThickness="3,0,0,0"
                                        Padding="12,7" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <!-- Wraps: one modifier can name nine charts,
                                                 and a horizontal stack would run it off
                                                 the edge rather than onto a second line. -->
                                            <WrapPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Headline}"
                                                           FontFamily="{x:Static local:PoeFonts.Display}" FontSize="{Binding HeadlineSize}"
                                                           Foreground="{Binding Accent}"/>
                                                <TextBlock Text="{Binding Where}" FontSize="11"
                                                           Foreground="{StaticResource Shade}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Detail}" FontSize="12"
                                                       Foreground="{StaticResource Ash}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
            </ContentControl>

            <!-- charts: the panel, mirrored -->
            <ContentControl Grid.Column="2" Style="{StaticResource Carved}" Margin="5,14,14,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" x:Name="PanelHeader" Text="C H A R T S"
                           Style="{StaticResource Eyebrow}"/>
                <!-- Top-aligned on purpose: the cells are fixed-size, and a stretched
                     UniformGrid spreads its rows over whatever height the window gains,
                     growing the gaps between charts with it. -->
                <Border Background="{StaticResource Slate}" BorderBrush="{StaticResource Silt}"
                        BorderThickness="1" Padding="4" VerticalAlignment="Top">
                    <UniformGrid x:Name="PanelGrid" Rows="10" Columns="6"/>
                </Border>
            </DockPanel>
            </ContentControl>
        </Grid>

        <!-- ===== capture + status ===== -->
        <StackPanel Grid.Row="2">
            <!-- Manual entry. Ctrl+C only works on things the game treats as items, so a
                 figurine may not be copyable at all; typing or pasting its text must work
                 or those twelve modifiers can never be captured. -->
            <Border Background="{StaticResource Slate}" BorderBrush="{StaticResource Silt}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TargetLabel" Text="Nothing selected" FontFamily="{x:Static local:PoeFonts.Display}"
                               FontSize="14" Foreground="{StaticResource Brass}"
                               VerticalAlignment="Center" Width="140"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBox Grid.Column="1" x:Name="DetailBox" Margin="10,0" MaxHeight="86"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             PreviewKeyDown="OnDetailKeyDown"
                             ToolTip="Paste or type the hover text. Ctrl+Enter applies."/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Apply" Click="OnApplyDetail" Margin="0,0,6,0"
                                ToolTip="Ctrl+Enter"/>
                        <Button Content="Skip" Click="OnSkipTarget"
                                ToolTip="Move on without capturing this one"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{StaticResource Abyss}" BorderBrush="{StaticResource Silt}"
                    BorderThickness="0,1,0,0" Padding="16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Status" Text="Open the Voyage screen in game, then Read panel."
                               Foreground="{StaticResource Ash}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="90" Height="4" Background="#1B1714" VerticalAlignment="Center">
                            <Rectangle x:Name="ProgressFill" Fill="{StaticResource Brass}"
                                       HorizontalAlignment="Left" Width="0"/>
                        </Border>
                        <TextBlock x:Name="Progress" Foreground="{StaticResource Ash}"
                                   FontFamily="Consolas" FontSize="12" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
